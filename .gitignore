# Root allowlist: never initialize Git over the private thesis workspace.
/*
!/.gitignore
!/README.md
!/requirements*.txt
!/configs/
!/docs/
!/tests/
!/tools/
!/.github/

# Research inputs, credentials, generated artifacts and model weights.
**/data/
**/outputs/
**/logs/
**/secrets/
**/checkpoints/
**/.env*
**/*.csv
**/*.tsv
**/*.jsonl
**/*.gz
**/*.zip
**/*.pdf
**/*.docx
**/*.xlsx
**/*.parquet
**/*.log
**/*.pem
**/*.key
**/*.pt
**/*.pth
**/*.bin
**/*.safetensors
**/*.gguf
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.venv*/
**/.pytest_cache/
